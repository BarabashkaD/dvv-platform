@PACKAGE_INIT@

# The version, with the release-stage label of a pre-release build (applications show it, e.g. in
# --version).
set(dvv_platform_VERSION_STRING "@dvv_platform_VERSION_STRING@")

include(CMakeFindDependencyMacro)
find_dependency(dvv_base @dvv_base_MIN_VERSION@)
if(NOT WIN32 AND NOT APPLE)
    find_dependency(X11)  # dvv::platform_testing links X11::X11
endif()

include("${CMAKE_CURRENT_LIST_DIR}/dvv_platformTargets.cmake")

check_required_components(dvv_platform)
